# Concept preview safeguards stay on unless this is exactly "false".
NEXT_PUBLIC_DEMO_MODE=true

# Supabase "Reel Funnels" project (Project Settings -> API Keys).
# The publishable key can only call log_reel_event and submit_lead, read
# published funnels, and sign admins in; admins' own sign-in tokens make
# every publish, checked by row-level security. No secret key is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: email the firm about each new lead via Resend.
# LEAD_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=intake@example.com
LEAD_FROM_EMAIL=Spectrum Website <leads@example.com>
