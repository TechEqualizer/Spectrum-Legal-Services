# Copy to .env.local for local development, and add the same variables in
# Vercel (Project Settings -> Environment Variables). Server-only: do not
# prefix with NEXT_PUBLIC_.

# Supabase "Reel Funnels" project (Project Settings -> API Keys).
# The publishable key can only call log_reel_event and submit_lead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: email the firm about each new lead via Resend.
# LEAD_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=intake@example.com
LEAD_FROM_EMAIL=Spectrum Website <leads@example.com>
