# Concept preview safeguards stay on unless this is exactly "false".
NEXT_PUBLIC_DEMO_MODE=true

# Supabase "Reel Funnels" project (Project Settings -> API Keys).
# The publishable key can only call log_reel_event and submit_lead, read
# published funnels, and sign admins in; admins' own sign-in tokens make
# every publish, checked by row-level security. No secret key is needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: email the firm about each new lead via Resend.
# LEAD_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=intake@example.com
LEAD_FROM_EMAIL=Spectrum Website <leads@example.com>

# Showlnk's contact details, shown on /terms and /privacy (and, for the
# postal address, in the footer of every email to fans, as CAN-SPAM requires).
SHOWLNK_CONTACT_EMAIL=
SHOWLNK_POSTAL_ADDRESS=

# Fans following organizers (docs/plans/02-fans.md). Following stays off
# until all of these are set, plus SHOWLNK_POSTAL_ADDRESS above:
# - SUPABASE_SECRET_KEY: the project's secret key (server-only; the fan
#   tables are closed to everything else);
# - RESEND_API_KEY: sign-in links go out from FAN_FROM_EMAIL, on
#   showlnk.com, verified in Resend;
# - FAN_COOKIE_SECRET: signs fans' cookies; any long random string
#   (openssl rand -base64 32). Changing it signs every fan out.
SUPABASE_SECRET_KEY=
FAN_COOKIE_SECRET=
FAN_FROM_EMAIL=fans@showlnk.com
# Organizers whose links show Follow (comma-separated slugs, or * for all).
# Empty: no one's, and their links keep "Updates" / "Text me later".
FOLLOW_ORGANIZERS=

# Optional: "Import flyer" in the admin reads event flyers with Claude
# (console.anthropic.com -> API Keys). Server-only; never sent to browsers.
ANTHROPIC_API_KEY=
